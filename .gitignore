# Plugin runtime data. Never commit this: plugins persist state here, and
# some of it is sensitive - autologin writes the MUD username and password
# into .storage/autologin.json. A .storage/ directory appears next to any
# profile lera runs, so it can show up here if a profile is run from this repo.
.storage/

# Isolated development worktrees
.worktrees/

# Editor files
*.swp
*~
.vscode/

# Python bytecode
__pycache__/
*.py[cod]

# OS files
.DS_Store
